    "tree-kill": "^1.2.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@omnimind/contracts": "workspace:*",
    "@omnimind/shared": "workspace:*",
    "@omnimind/web": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "tsdown": "catalog:",
    "typescript": "catalog:",
