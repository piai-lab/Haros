{
  "name": "@harnessos/desktop",
  "version": "0.1.0-alpha.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun run scripts/dev.mjs",
    "dev:bundle": "tsdown --watch",
    "dev:electron": "bun run scripts/dev-electron.mjs",
    "build": "tsdown",
    "start": "bun run scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:related": "vitest related --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "betterwright": "2.7.3",
    "effect": "catalog:",
    "electron": "43.4.1",
    "electron-updater": "^6.6.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@harnessos/contracts": "workspace:*",
    "@harnessos/shared": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "playwright": "^1.58.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wait-on": "^8.0.2"
  },
  "productName": "Haros"
}
