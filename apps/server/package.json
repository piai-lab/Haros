{
  "name": "@harnessos/server",
  "version": "0.1.0-alpha.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "harnessos": "dist/index.mjs",
    "harnessos-restore-migration-backup": "dist/restoreMigrationBackup.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "node scripts/cli.ts build",
    "start": "node dist/index.mjs",
    "prepare": "effect-language-service patch",
    "ask-user-live": "bun run scripts/verify-ask-user-live.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:unit": "vitest run --project unit --maxWorkers=4",
    "test:integration": "vitest run --project integration --project git-integration --maxWorkers=4",
    "test:related": "vitest related --maxWorkers=4"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.207",
    "@anthropic-ai/sdk": "^0.100.0",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@harnessos/om-ask": "workspace:*",
    "@harnessos/om-web-access": "workspace:*",
    "@harnessos/pi-coding-agent": "file:../../vendor/omnimind-pi-coding-agent-0.84.3.tgz",
    "@opencode-ai/sdk": "^1.15.13",
    "@pierre/diffs": "^1.2.12",
    "@xterm/headless": "^6.0.0",
    "effect": "catalog:",
    "jsonc-parser": "3.3.1",
    "marked": "15.0.12",
    "node-pty": "^1.1.0",
    "open": "^10.1.0",
    "tree-kill": "^1.2.2",
    "undici": "8.9.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@harnessos/contracts": "workspace:*",
    "@harnessos/shared": "workspace:*",
    "@harnessos/web": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "4.3.6"
  },
  "engines": {
    "node": "^22.19 || ^23.11 || >=24.10"
  }
}
