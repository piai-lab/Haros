+
+function deleteOmittedEditableFields<T extends object>(
+	merged: T,
+	edited: T,
+	fields: readonly (keyof T)[],
+): void {
+	for (const field of fields) {
+		if (!Object.prototype.hasOwnProperty.call(edited, field)) {
+			delete (merged as Partial<T>)[field];
+		}
+	}
+}
+
+function mergeEditedModels(
+	currentModels: readonly ModelsJsonModel[] | undefined,
+	editedModels: readonly ModelsJsonModel[],
+): ModelsJsonModel[] {
+	const currentById = new Map((currentModels ?? []).map((model) => [model.id, model]));
+	return editedModels.map((editedModel) => {
+		const currentModel = currentById.get(editedModel.id);
+		if (!currentModel) return structuredClone(editedModel);
+		const merged = {
+			...structuredClone(currentModel),
+			...structuredClone(editedModel),
+		} as ModelsJsonModel;
+		if (Object.prototype.hasOwnProperty.call(editedModel, "compat")) {
+			const currentCompat = structuredClone(currentModel.compat ?? {}) as Record<string, unknown>;
+			const editedCompat = structuredClone(editedModel.compat ?? {}) as Record<string, unknown>;
+			const mergedCompat = { ...currentCompat, ...editedCompat };
+			deleteOmittedEditableFields(
+				mergedCompat,
+				editedCompat,
+				MODEL_CONFIG_EDITABLE_COMPAT_FIELDS,
+			);
+			if (Object.keys(mergedCompat).length > 0) merged.compat = mergedCompat;
+			else delete merged.compat;
+		}
+		deleteOmittedEditableFields(merged, editedModel, MODEL_CONFIG_EDITABLE_MODEL_FIELDS);
+		return merged;
+	});
+}
+
+/** Merge one credential-blind edit while retaining Pi-owned fields on matching models. */
+export function mergeModelConfigProviderEdit(
+	currentProvider: ModelsJsonProvider | undefined,
+	editedProvider: ModelsJsonProvider,
+): ModelsJsonProvider {
+	const merged = {
+		...(currentProvider ? structuredClone(currentProvider) : {}),
+		...structuredClone(editedProvider),
+		...(editedProvider.models
+			? { models: mergeEditedModels(currentProvider?.models, editedProvider.models) }
+			: {}),
+	};
+	deleteOmittedEditableFields(merged, editedProvider, MODEL_CONFIG_EDITABLE_PROVIDER_FIELDS);
+	return merged;
+}
+
+function encodeCredentialReference(mutation: ModelConfigCredentialReferenceMutation): string | undefined {
+	if (mutation.type === "clear") return undefined;
+	if (mutation.type === "environment") {
+		if (!ENVIRONMENT_VARIABLE_NAME.test(mutation.variableName)) {
+			throw new Error("Credential environment variable name is invalid");
+		}
+		return `\${${mutation.variableName}}`;
+	}
+	if (
+		mutation.command.length === 0 ||
+		mutation.command.length > MAX_CREDENTIAL_COMMAND_LENGTH ||
+		mutation.command !== mutation.command.trim() ||
+		/[\u0000-\u001f\u007f-\u009f]/u.test(mutation.command)
+	) {
+		throw new Error("Credential command is invalid");
+	}
+	return `!${mutation.command}`;
+}
+
+function headerReferenceSource(value: string): ModelConfigHeaderReferenceSource {
+	if (isCommandConfigValue(value)) return "command";
+	return getConfigValueEnvVarNames(value).length > 0 ? "environment" : "external";
+}
+
+function headerMetadata(
+	headers: Readonly<Record<string, string>> | undefined,
+): ModelConfigHeaderReferenceMetadata[] {
+	if (!headers) return [];
+	const normalized = new Map<string, [string, string]>();
+	for (const [name, value] of Object.entries(headers)) {
+		if (name.length === 0 || name.length > 128 || !HEADER_NAME.test(name)) continue;
+		normalized.set(name.toLowerCase(), [name, value]);
+	}
+	const entries = [...normalized.values()].slice(0, MAX_HEADER_REFERENCES);
+	return entries.map(([name, value]) => ({ name, source: headerReferenceSource(value) }));
+}
+
+function validateHeaderReferenceName(
+	name: string,
+	referenceType: ModelConfigHeaderReferenceValueMutation["type"],
+): string {
+	if (name.length === 0 || name.length > 128 || !HEADER_NAME.test(name)) {
+		throw new Error("Header name is invalid");
+	}
+	const normalizedName = name.toLowerCase();
+	if (referenceType !== "clear" && FORBIDDEN_HEADER_NAMES.has(normalizedName)) {
+		throw new Error("Header name is reserved by the request or credential owner");
+	}
+	return normalizedName;
+}
+
+function applyHeaderReferenceMutations(
+	provider: ModelsJsonProvider,
+	mutations: readonly ModelConfigHeaderReferenceMutation[] | undefined,
+): ModelsJsonProvider {
+	if (!mutations?.length) return provider;
+	if (mutations.length > MAX_HEADER_REFERENCES) {
+		throw new Error("Too many header reference mutations");
+	}
+	const edited = structuredClone(provider);
+	const seen = new Set<string>();
+	for (const mutation of mutations) {
+		if (mutation.reference.type !== "environment" && mutation.reference.type !== "clear") {
+			throw new Error("Header reference type is not supported");
+		}
+		const normalizedName = validateHeaderReferenceName(mutation.name, mutation.reference.type);
+		const scopeKey =
+			mutation.scope.type === "provider"
+				? `provider\0${normalizedName}`
+				: `model\0${mutation.scope.modelId}\0${normalizedName}`;
+		if (seen.has(scopeKey)) throw new Error("Duplicate header reference mutation");
+		seen.add(scopeKey);
+		let target: ModelsJsonProvider | ModelsJsonModel;
+		if (mutation.scope.type === "provider") {
+			target = edited;
+		} else {
+			const modelId = mutation.scope.modelId;
+			if (!modelId.trim() || modelId !== modelId.trim()) {
+				throw new Error("Header model id is invalid");
+			}
+			const model = edited.models?.find((entry) => entry.id === modelId);
+			if (!model) throw new Error("Header model target is unavailable");
+			target = model;
+		}
+		const headers = { ...(target.headers ?? {}) };
+		for (const currentName of Object.keys(headers)) {
+			if (currentName.toLowerCase() === normalizedName) delete headers[currentName];
+		}
+		const value =
+			mutation.reference.type === "clear"
+				? undefined
+				: encodeCredentialReference(mutation.reference);
+		if (value !== undefined) headers[mutation.name] = value;
+		if (Object.keys(headers).length > MAX_HEADER_REFERENCES) {
+			throw new Error("Configured headers exceed the safe mutation boundary");
+		}
+		if (Object.keys(headers).length > 0) target.headers = headers;
+		else delete target.headers;
+		if (mutation.scope.type === "model") {
+			const override = edited.modelOverrides?.[mutation.scope.modelId];
+			if (override?.headers) {
+				const overrideHeaders = { ...override.headers };
+				for (const currentName of Object.keys(overrideHeaders)) {
+					if (currentName.toLowerCase() === normalizedName) delete overrideHeaders[currentName];
+				}
+				if (Object.keys(overrideHeaders).length > 0) override.headers = overrideHeaders;
+				else delete override.headers;
+			}
+		}
+	}
+	return edited;
+}
+
+function isMissingPathError(error: unknown): boolean {
+	return typeof error === "object" && error !== null && "code" in error && error.code === "ENOENT";
+}
+
+function formattingOptions(content: string): {
+	insertSpaces: boolean;
+	tabSize: number;
+	eol: string;
+} {
+	const indentation = content.match(/(?:^|\r?\n)([ \t]+)"providers"\s*:/)?.[1] ?? "\t";
+	return {
+		insertSpaces: !indentation.includes("\t"),
+		tabSize: indentation.includes("\t") ? 4 : Math.max(1, indentation.length),
+		eol: content.includes("\r\n") ? "\r\n" : "\n",
+	};
+}
+
+type ModelConfigFileSnapshot = {
+	readonly content: string | undefined;
+	readonly identity:
+		| {
+				readonly dev: number;
+				readonly ino: number;
+				readonly size: number;
+				readonly mtimeMs: number;
+		  }
+		| undefined;
+};
+
+async function readModelConfigFile(modelsJsonPath: string, signal?: AbortSignal): Promise<ModelConfigFileSnapshot> {
+	signal?.throwIfAborted();
+	const flags = fsConstants.O_RDONLY | (fsConstants.O_NOFOLLOW ?? 0);
+	let handle: Awaited<ReturnType<typeof open>>;
+	try {
+		handle = await open(modelsJsonPath, flags);
+	} catch (error) {
+		if (isMissingPathError(error)) return { content: undefined, identity: undefined };
+		throw error;
+	}
+	try {
+		const metadata = await handle.stat();
+		if (!metadata.isFile() || metadata.nlink !== 1 || metadata.size > MAX_MODELS_CONFIG_BYTES) {
+			throw new Error("models.json is not a private regular file or exceeds the safe mutation boundary");
+		}
+		const bytes = await handle.readFile();
+		signal?.throwIfAborted();
+		return {
+			content: new TextDecoder("utf-8", { fatal: true }).decode(bytes),
+			identity: {
+				dev: metadata.dev,
+				ino: metadata.ino,
+				size: metadata.size,
+				mtimeMs: metadata.mtimeMs,
+			},
+		};
+	} finally {
+		await handle.close();
+	}
+}
+
+async function assertModelConfigUnchanged(
+	modelsJsonPath: string,
+	identity: ModelConfigFileSnapshot["identity"],
+): Promise<void> {
+	try {
+		const current = await lstat(modelsJsonPath);
+		if (
+			!identity ||
+			current.isSymbolicLink() ||
+			!current.isFile() ||
+			current.nlink !== 1 ||
