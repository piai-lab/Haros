diff --git a/packages/coding-agent/test/model-runtime-config-reader.test.ts b/packages/coding-agent/test/model-runtime-config-reader.test.ts
new file mode 100644
index 000000000..ec6eab86f
--- /dev/null
+++ b/packages/coding-agent/test/model-runtime-config-reader.test.ts
@@ -0,0 +1,192 @@
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import { ModelRegistry } from "../src/core/model-registry.ts";
+import { ModelRuntime } from "../src/core/model-runtime.ts";
+import { InMemoryCodingAgentModelsStore } from "../src/core/models-store.ts";
+
+function modelsJson(provider: string, model: string): string {
+	return `{
+		// The product reader supplies bytes; Pi remains the parser and schema authority.
+		"providers": {
+			"${provider}": {
+				"baseUrl": "https://example.test/v1",
+				"api": "openai-completions",
+				"apiKey": "test-key",
+				"models": [{ "id": "${model}" }]
+			}
+		}
+	}`;
+}
+
+function createRuntime(modelsConfigReader: NonNullable<Parameters<typeof ModelRuntime.create>[0]["modelsConfigReader"]>) {
+	return ModelRuntime.create({
+		credentials: AuthStorage.inMemory(),
+		modelsPath: null,
+		modelsConfigReader,
+		modelsStore: new InMemoryCodingAgentModelsStore(),
+		allowModelNetwork: false,
+		refreshOnCreate: false,
+	});
+}
+
+describe("ModelRuntime modelsConfigReader", () => {
+	it("uses one official parser snapshot for create and refresh provenance", async () => {
+		let content = modelsJson("custom-one", "model-one");
+		const reader = vi.fn(async () => content);
+		const runtime = await createRuntime(reader);
+
+		expect(reader).toHaveBeenCalledTimes(1);
+		expect(runtime.getModelConfigProviderIds()).toEqual(["custom-one"]);
+		expect(runtime.getModel("custom-one", "model-one")).toBeDefined();
+
+		content = modelsJson("custom-two", "model-two");
+		await runtime.refresh({ allowNetwork: false });
+
+		expect(reader).toHaveBeenCalledTimes(2);
+		expect(runtime.getModelConfigProviderIds()).toEqual(["custom-two"]);
+		expect(runtime.getModel("custom-one", "model-one")).toBeUndefined();
+		expect(runtime.getModel("custom-two", "model-two")).toBeDefined();
+	});
+
+	it("rejects path and reader dual authority", async () => {
+		const reader = async () => undefined;
+		await expect(ModelRuntime.create({ modelsConfigReader: reader })).rejects.toThrow(
+			"modelsConfigReader requires modelsPath: null",
+		);
+		await expect(ModelRuntime.create({ modelsPath: "/tmp/models.json", modelsConfigReader: reader })).rejects.toThrow(
+			"modelsConfigReader requires modelsPath: null",
+		);
+	});
+
+	it("propagates cancellation before and after the reader", async () => {
+		const before = new AbortController();
+		before.abort();
+		const unread = vi.fn(async () => modelsJson("unread", "unread"));
+		await expect(
+			ModelRuntime.create({ modelsPath: null, modelsConfigReader: unread, signal: before.signal }),
+		).rejects.toMatchObject({ name: "AbortError" });
+		expect(unread).not.toHaveBeenCalled();
+
+		const during = new AbortController();
+		await expect(
+			ModelRuntime.create({
+				modelsPath: null,
+				modelsConfigReader: async () => {
+					during.abort();
+					return modelsJson("cancelled", "cancelled");
+				},
+				signal: during.signal,
+			}),
+		).rejects.toMatchObject({ name: "AbortError" });
+	});
+
+	it("keeps reader failures private and invalid content under the official schema", async () => {
+		const failed = await createRuntime(async () => {
+			throw new Error("secret path and credential");
+		});
+		expect(failed.getError()).toBe("Failed to load models.json from configured reader");
+
+		const invalid = await createRuntime(async () => '{ "providers": { "broken": { "models": "wrong" } } }');
+		expect(invalid.getError()).toContain("Invalid models.json schema");
+		expect(invalid.getModelConfigProviderIds()).toEqual([]);
+	});
+
+	it("keeps an explicit file catalog store when models config comes from a reader", async () => {
+		const root = await mkdtemp(join(tmpdir(), "omnimind-model-reader-store-"));
+		const modelsStorePath = join(root, "models-store.json");
+		const providerId = "reader-store-provider";
+		const storedModel = {
+			id: "stored-model",
+			name: "Stored Model",
+			api: "openai-responses" as const,
+			provider: providerId,
+			baseUrl: "https://example.test/v1",
+			reasoning: false,
+			input: ["text"] as const,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+			contextWindow: 128_000,
+			maxTokens: 16_384,
+		};
+		const refreshedModel = { ...storedModel, id: "reopened-model", name: "Reopened Model" };
+		const observedStoredModelIds: string[][] = [];
+		const registerDynamicProvider = (runtime: ModelRuntime, publishRefreshed: boolean) => {
+			let models = [] as (typeof storedModel)[];
+			new ModelRegistry(runtime).registerProvider({
+				id: providerId,
+				name: "Reader Store Provider",
+				auth: {
+					apiKey: {
+						name: "Reader store key",
+						resolve: async () => ({ auth: { apiKey: "test-key" }, source: "test" }),
+					},
+				},
+				getModels: () => models,
+				refreshModels: async (context) => {
+					observedStoredModelIds.push(context.stored?.models.map((model) => model.id) ?? []);
+					if (context.stored) {
+						await context.publish({
+							update: () => {
+								models = [...context.stored!.models] as (typeof storedModel)[];
+							},
+						});
+					}
+					if (!publishRefreshed) return;
+					await context.publish({
+						persist: { models: [refreshedModel], checkedAt: Date.now() },
+						update: () => {
+							models = [refreshedModel];
+						},
+					});
+				},
+				stream: () => {
+					throw new Error("unused");
+				},
+				streamSimple: () => {
+					throw new Error("unused");
+				},
+			});
+		};
+
+		try {
+			await writeFile(
+				modelsStorePath,
+				JSON.stringify({
+					[providerId]: { models: [storedModel], checkedAt: 1 },
+				}),
+			);
+			const first = await ModelRuntime.create({
+				credentials: AuthStorage.inMemory(),
+				modelsPath: null,
+				modelsConfigReader: async () => undefined,
+				modelsStorePath,
+				allowModelNetwork: false,
+				refreshOnCreate: false,
+			});
+			registerDynamicProvider(first, true);
+			await first.refresh({ providers: [providerId], allowNetwork: false });
+			expect(observedStoredModelIds).toEqual([["stored-model"]]);
+			expect(first.getModel(providerId, "reopened-model")).toBeDefined();
+			const persisted = JSON.parse(await readFile(modelsStorePath, "utf8"));
+			expect(persisted[providerId].models.map((model: { id: string }) => model.id)).toEqual(["reopened-model"]);
+
+			const reopened = await ModelRuntime.create({
+				credentials: AuthStorage.inMemory(),
+				modelsPath: null,
+				modelsConfigReader: async () => undefined,
+				modelsStorePath,
+				allowModelNetwork: false,
+				refreshOnCreate: false,
+			});
+			registerDynamicProvider(reopened, false);
+			await reopened.refresh({ providers: [providerId], allowNetwork: false });
+			expect(observedStoredModelIds).toEqual([["stored-model"], ["reopened-model"]]);
+			expect(reopened.getModel(providerId, "stored-model")).toBeUndefined();
+			expect(reopened.getModel(providerId, "reopened-model")).toBeDefined();
+		} finally {
+			await rm(root, { recursive: true, force: true });
+		}
+	});
+});
