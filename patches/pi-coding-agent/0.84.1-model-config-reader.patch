+++ b/packages/coding-agent/test/model-session-prompt-outcome.test.ts
@@ -0,0 +1,224 @@
+import { fauxAssistantMessage } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it } from "vitest";
+import llamaExtension from "../src/extensions/llama/index.ts";
+import { createHarness, type Harness } from "./suite/harness.ts";
+
+describe("AgentSession prompt outcomes", () => {
+	const harnesses: Harness[] = [];
+
+	afterEach(() => {
+		while (harnesses.length > 0) harnesses.pop()?.cleanup();
+	});
+
+	it("reports a command handled without starting an agent run", async () => {
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerCommand("noop", {
+						description: "No-op command",
+						handler: async () => {},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		const events: string[] = [];
+		harness.session.subscribe((event) => events.push(event.type));
+
+		const outcome = await harness.session.prompt("/noop");
+
+		expect(outcome).toEqual({ kind: "handled-without-agent", success: true });
+		expect(events).not.toContain("agent_start");
+		expect(events).not.toContain("agent_settled");
+	});
+
+	it("settles the bundled /llama command without an agent run outside TUI mode", async () => {
+		const harness = await createHarness({ extensionFactories: [llamaExtension] });
+		harnesses.push(harness);
+
+		const outcome = await harness.session.prompt("/llama");
+
+		expect(outcome).toEqual({ kind: "handled-without-agent", success: true });
+		expect(harness.eventsOfType("agent_start")).toEqual([]);
+		expect(harness.eventsOfType("agent_settled")).toEqual([]);
+	});
+
+	it("reports a command failure without exposing it as an agent run", async () => {
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerCommand("fail", {
+						description: "Failing command",
+						handler: async () => {
+							throw new Error("command failed");
+						},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+
+		await expect(harness.session.prompt("/fail")).resolves.toEqual({
+			kind: "handled-without-agent",
+			success: false,
+		});
+	});
+
+	it("reports an input hook handled without starting an agent run", async () => {
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.on("input", async () => ({ action: "handled" }));
+				},
+			],
+		});
+		harnesses.push(harness);
+		const events: string[] = [];
+		harness.session.subscribe((event) => events.push(event.type));
+
+		const outcome = await harness.session.prompt("handled by input hook");
+
+		expect(outcome).toEqual({ kind: "handled-without-agent", success: true });
+		expect(events).not.toContain("agent_start");
+		expect(events).not.toContain("agent_settled");
+	});
+
+	it("waits for an agent run dispatched by a fire-and-forget command action", async () => {
+		let releaseResponse!: () => void;
+		const responseGate = new Promise<void>((resolve) => {
+			releaseResponse = resolve;
+		});
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerCommand("agent", {
+						description: "Agent command",
+						handler: async () => {
+							pi.sendUserMessage("from command");
+						},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		harness.setResponses([
+			async () => {
+				await responseGate;
+				return fauxAssistantMessage("done");
+			},
+		]);
+		let settled = false;
+		harness.session.subscribe((event) => {
+			if (event.type === "agent_settled") settled = true;
+		});
+
+		const outcomePromise = harness.session.prompt("/agent");
+		await Promise.resolve();
+		expect(settled).toBe(false);
+		releaseResponse();
+
+		await expect(outcomePromise).resolves.toEqual({ kind: "agent-run" });
+		expect(settled).toBe(true);
+	});
+
+	it("reports command failure after Agent work scheduled by that command settles", async () => {
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerCommand("mixed-failure", {
+						description: "Schedules Agent work and then fails",
+						handler: async () => {
+							pi.sendUserMessage("from failing command");
+							throw new Error("command failed after scheduling");
+						},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		harness.setResponses([fauxAssistantMessage("agent response")]);
+
+		const outcome = await harness.session.prompt("/mixed-failure");
+
+		expect(outcome).toEqual({ kind: "handled-without-agent", success: false });
+		expect(harness.eventsOfType("agent_settled")).toHaveLength(1);
+	});
+
+	it("waits for an agent run dispatched by a trigger-turn custom message", async () => {
+		let releaseResponse!: () => void;
+		const responseGate = new Promise<void>((resolve) => {
+			releaseResponse = resolve;
+		});
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerCommand("custom-agent", {
+						description: "Agent custom message command",
+						handler: async () => {
+							pi.sendMessage(
+								{ customType: "test", content: "from command", display: true },
+								{ triggerTurn: true },
+							);
+						},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		harness.setResponses([
+			async () => {
+				await responseGate;
+				return fauxAssistantMessage("done");
+			},
+		]);
+
+		const outcomePromise = harness.session.prompt("/custom-agent");
+		let resolved = false;
+		void outcomePromise.then(() => {
+			resolved = true;
+		});
+		await Promise.resolve();
+		expect(resolved).toBe(false);
+		releaseResponse();
+
+		await expect(outcomePromise).resolves.toEqual({ kind: "agent-run" });
+		expect(harness.eventsOfType("agent_settled")).toHaveLength(1);
+	});
+
+	it("waits for an agent run dispatched by a handled input hook", async () => {
+		let releaseResponse!: () => void;
+		const responseGate = new Promise<void>((resolve) => {
+			releaseResponse = resolve;
+		});
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.on("input", async (event) => {
+						if (event.source !== "interactive") return { action: "continue" };
+						pi.sendUserMessage("from input hook");
+						return { action: "handled" };
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		harness.setResponses([
+			async () => {
+				await responseGate;
+				return fauxAssistantMessage("done");
+			},
+		]);
+
+		const outcomePromise = harness.session.prompt("handled and dispatched");
+		let resolved = false;
+		void outcomePromise.then(() => {
+			resolved = true;
+		});
+		await Promise.resolve();
+		expect(resolved).toBe(false);
+		releaseResponse();
+
+		await expect(outcomePromise).resolves.toEqual({ kind: "agent-run" });
+		expect(harness.eventsOfType("agent_settled")).toHaveLength(1);
+	});
+});
