+import { link, lstat, mkdtemp, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { ModelRuntime, mutateModelConfigProvider } from "../src/core/model-runtime.ts";
+
+const roots: string[] = [];
+
+async function createRoot(): Promise<string> {
+	const root = await mkdtemp(join(tmpdir(), "pi-model-config-mutation-"));
+	roots.push(root);
+	return root;
+}
+
+function provider(name: string, modelId: string) {
+	return {
+		name,
+		baseUrl: "https://example.test/v1",
+		api: "openai-completions",
+		models: [{ id: modelId }],
+	};
+}
+
+afterEach(async () => {
+	await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true })));
+});
+
+describe("persistent ModelConfig provider mutation", () => {
+	it("upserts one provider while preserving comments and unrelated unknown fields", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		const untouchedProvider = `"existing": {
+			// This comment and unknown field must survive byte-for-byte.
+			"baseUrl": "https://existing.test/v1",
+			"api": "openai-responses",
+			"futureProviderField": { "keep": true },
+			"models": [{ "id": "existing-model", "futureModelField": 7 }]
+		}`;
+		await writeFile(
+			modelsPath,
+			`{
+		// Root comments and future fields are not the mutation target.
+		"futureRootField": { "keep": true },
+		"providers": {
+			${untouchedProvider}
+		}
+	}\n`,
+			{ encoding: "utf8", mode: 0o600 },
+		);
+
+		const result = await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "custom-one",
+			provider: provider("Custom One", "model-one"),
+		});
+		const content = await readFile(modelsPath, "utf8");
+
+		expect(result).toEqual({ changed: true, providerIds: ["existing", "custom-one"] });
+		expect(content).toContain("// Root comments and future fields are not the mutation target.");
+		expect(content).toContain('"futureRootField": { "keep": true }');
+		expect(content).toContain(untouchedProvider);
+		expect(content).toContain('"custom-one"');
+		expect((await lstat(modelsPath)).mode & 0o777).toBe(0o600);
+	});
+
+	it("serializes concurrent provider mutations without dropping either update", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+
+		await Promise.all([
+			mutateModelConfigProvider(modelsPath, {
+				type: "upsert",
+				providerId: "custom-one",
+				provider: provider("Custom One", "model-one"),
+			}),
+			mutateModelConfigProvider(modelsPath, {
+				type: "upsert",
+				providerId: "custom-two",
+				provider: provider("Custom Two", "model-two"),
+			}),
+		]);
+
+		const content = await readFile(modelsPath, "utf8");
+		expect(content).toContain('"custom-one"');
+		expect(content).toContain('"custom-two"');
+	});
+
+	it("replaces only an existing target provider", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "target",
+			provider: provider("Old Target", "old-model"),
+		});
+		const withFutureTargetField = (await readFile(modelsPath, "utf8")).replace(
+			'"name": "Old Target",',
+			'"name": "Old Target",\n\t\t"futureTargetField": { "keep": true },',
+		);
+		await writeFile(modelsPath, withFutureTargetField, { encoding: "utf8", mode: 0o600 });
+		await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "untouched",
+			provider: provider("Untouched", "keep-model"),
+		});
+
+		const result = await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "target",
+			provider: provider("New Target", "new-model"),
+		});
+		const content = await readFile(modelsPath, "utf8");
+
+		expect(result).toEqual({ changed: true, providerIds: ["target", "untouched"] });
+		expect(content).toContain('"New Target"');
+		expect(content).toContain('"new-model"');
+		expect(content).not.toContain('"Old Target"');
+		expect(content).not.toContain('"old-model"');
+		expect(content).toContain('"futureTargetField": { "keep": true }');
+		expect(content).toContain('"Untouched"');
+		expect(content).toContain('"keep-model"');
+	});
+
+	it("preserves existing credential and compatibility fields omitted by an edit", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		await writeFile(
+			modelsPath,
+			JSON.stringify({
+				providers: {
+					target: {
+						...provider("Old Target", "old-model"),
+						apiKey: "existing-safe-reference",
+						headers: { "X-Existing": "keep" },
+						compat: { supportsStore: false },
+					},
+				},
+			}),
+			{ encoding: "utf8", mode: 0o600 },
+		);
+
+		await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "target",
+			provider: provider("New Target", "new-model"),
+		});
+
+		const content = await readFile(modelsPath, "utf8");
+		expect(content).toContain('"New Target"');
+		expect(content).toContain('"new-model"');
+		const target = JSON.parse(content).providers.target;
+		expect(target.apiKey).toBe("existing-safe-reference");
+		expect(target.headers).toEqual({ "X-Existing": "keep" });
+		expect(target.compat).toEqual({ supportsStore: false });
+	});
+
+	it("removes only the target provider and treats a missing target as an exact no-op", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "keep",
+			provider: provider("Keep", "keep-model"),
+		});
+		await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "remove",
+			provider: provider("Remove", "remove-model"),
+		});
+		const before = await readFile(modelsPath, "utf8");
+
+		const removed = await mutateModelConfigProvider(modelsPath, {
+			type: "remove",
+			providerId: "remove",
+		});
+		const after = await readFile(modelsPath, "utf8");
+		expect(removed).toEqual({ changed: true, providerIds: ["keep"] });
+		expect(after).toContain('"keep"');
+		expect(after).not.toContain('"remove"');
+
+		const missing = await mutateModelConfigProvider(modelsPath, {
+			type: "remove",
+			providerId: "missing",
+		});
+		expect(missing).toEqual({ changed: false, providerIds: ["keep"] });
+		expect(await readFile(modelsPath, "utf8")).toBe(after);
+		expect(before).not.toBe(after);
+	});
+
+	it("rejects invalid typed content without changing the last valid file", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "valid",
+			provider: provider("Valid", "valid-model"),
+		});
+		const before = await readFile(modelsPath, "utf8");
+
+		await expect(
+			mutateModelConfigProvider(modelsPath, {
+				type: "upsert",
+				providerId: "invalid",
+				provider: { models: "wrong" } as never,
+			}),
+		).rejects.toThrow("Invalid models.json schema");
+		expect(await readFile(modelsPath, "utf8")).toBe(before);
+	});
+
+	it("rejects a schema-valid provider that a fresh runtime cannot compose", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "valid",
+			provider: provider("Valid", "valid-model"),
+		});
+		const before = await readFile(modelsPath, "utf8");
+
+		await expect(
+			mutateModelConfigProvider(modelsPath, {
+				type: "upsert",
+				providerId: "cannot-compose",
+				provider: {
+					...provider("Cannot Compose", "broken-model"),
+					api: "not-a-real-pi-api",
+				} as never,
+			}),
+		).rejects.toThrow();
+		expect(await readFile(modelsPath, "utf8")).toBe(before);
+	});
+
+	it("is exactly reloadable by a fresh official runtime after replacement", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "reloadable",
+			provider: provider("Reloadable", "reload-model"),
+		});
+
+		const runtime = await ModelRuntime.create({
+			modelsPath,
+			allowModelNetwork: false,
+			refreshOnCreate: false,
+		});
+		expect(runtime.getError()).toBeUndefined();
+		expect(runtime.getModelConfigProviderIds()).toContain("reloadable");
+		expect(runtime.getModel("reloadable", "reload-model")).toBeDefined();
+	});
+
+	it("rejects an invalid existing document without rewriting it", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		const invalid = '{ "providers": { "broken": { "models": "wrong" } } }\n';
+		await writeFile(modelsPath, invalid, { encoding: "utf8", mode: 0o600 });
+
+		await expect(
+			mutateModelConfigProvider(modelsPath, {
+				type: "upsert",
+				providerId: "blocked",
+				provider: provider("Blocked", "blocked-model"),
+			}),
+		).rejects.toThrow("Invalid models.json schema");
+		expect(await readFile(modelsPath, "utf8")).toBe(invalid);
+	});
+
+	it("rejects a linked models.json leaf instead of replacing it", async () => {
+		const root = await createRoot();
+		const outside = join(root, "outside.json");
+		const modelsPath = join(root, "models.json");
+		await writeFile(outside, '{ "providers": {} }', { mode: 0o600 });
+		await symlink(outside, modelsPath);
+
+		await expect(
+			mutateModelConfigProvider(modelsPath, {
+				type: "upsert",
+				providerId: "blocked",
+				provider: provider("Blocked", "blocked-model"),
+			}),
+		).rejects.toThrow();
+		expect(await readFile(outside, "utf8")).toBe('{ "providers": {} }');
+	});
+
+	it("rejects a multiply linked models.json leaf", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		const aliasPath = join(root, "models-alias.json");
+		const original = '{ "providers": {} }';
+		await writeFile(modelsPath, original, { mode: 0o600 });
+		await link(modelsPath, aliasPath);
+
+		await expect(
+			mutateModelConfigProvider(modelsPath, {
+				type: "upsert",
+				providerId: "blocked",
+				provider: provider("Blocked", "blocked-model"),
+			}),
+		).rejects.toThrow("private regular file");
+		expect(await readFile(aliasPath, "utf8")).toBe(original);
+	});
+
+	it("honors caller cancellation before creating or changing the file", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		const controller = new AbortController();
+		controller.abort();
+
+		await expect(
+			mutateModelConfigProvider(
+				modelsPath,
+				{
+					type: "upsert",
+					providerId: "cancelled",
+					provider: provider("Cancelled", "cancelled-model"),
+				},
+				{ signal: controller.signal },
+			),
+		).rejects.toMatchObject({ name: "AbortError" });
+		await expect(readFile(modelsPath, "utf8")).rejects.toMatchObject({ code: "ENOENT" });
+	});
+});
diff --git a/packages/coding-agent/test/model-runtime-config-reader.test.ts b/packages/coding-agent/test/model-runtime-config-reader.test.ts
