+const roots: string[] = [];
+
+async function createRoot(): Promise<string> {
+	const root = await mkdtemp(join(tmpdir(), "pi-model-config-mutation-"));
+	roots.push(root);
+	return root;
+}
+
+async function exists(path: string): Promise<boolean> {
+	try {
+		await lstat(path);
+		return true;
+	} catch {
+		return false;
+	}
+}
+
+function provider(name: string, modelId: string) {
+	return {
+		name,
+		baseUrl: "https://example.test/v1",
+		api: "openai-completions",
+		models: [{ id: modelId }],
+	};
+}
+
+afterEach(async () => {
+	await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true })));
+});
