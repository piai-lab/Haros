+describe("persistent ModelConfig provider mutation", () => {
+	it("upserts one provider while preserving comments and unrelated unknown fields", async () => {
+		const root = await createRoot();
+		const modelsPath = join(root, "models.json");
+		const untouchedProvider = `"existing": {
+			// This comment and unknown field must survive byte-for-byte.
+			"baseUrl": "https://existing.test/v1",
+			"api": "openai-responses",
+			"futureProviderField": { "keep": true },
+			"models": [{ "id": "existing-model", "futureModelField": 7 }]
+		}`;
+		await writeFile(
+			modelsPath,
+			`{
+		// Root comments and future fields are not the mutation target.
+		"futureRootField": { "keep": true },
+		"providers": {
+			${untouchedProvider}
+		}
+	}\n`,
+			{ encoding: "utf8", mode: 0o600 },
+		);
+
+		const result = await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "custom-one",
+			provider: provider("Custom One", "model-one"),
+		});
+		const content = await readFile(modelsPath, "utf8");
+
+		expect(result).toEqual({ changed: true, providerIds: ["existing", "custom-one"] });
+		expect(content).toContain("// Root comments and future fields are not the mutation target.");
+		expect(content).toContain('"futureRootField": { "keep": true }');
+		expect(content).toContain(untouchedProvider);
+		expect(content).toContain('"custom-one"');
+		expect((await lstat(modelsPath)).mode & 0o777).toBe(0o600);
+	});
+
+	it("serializes concurrent provider mutations without dropping either update", async () => {
+		const root = await createRoot();
