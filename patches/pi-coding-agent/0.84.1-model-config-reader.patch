+		);
+		await writeFile(modelsPath, withFutureTargetField, { encoding: "utf8", mode: 0o600 });
+		await mutateModelConfigProvider(modelsPath, {
+			type: "upsert",
+			providerId: "untouched",
+			provider: provider("Untouched", "keep-model"),
