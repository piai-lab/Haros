+		const flags = fsConstants.O_CREAT | fsConstants.O_EXCL | fsConstants.O_WRONLY | (fsConstants.O_NOFOLLOW ?? 0);
+		const handle = await open(temporaryPath, flags, MODELS_CONFIG_FILE_MODE);
+		try {
+			await handle.writeFile(nextContent, "utf8");
