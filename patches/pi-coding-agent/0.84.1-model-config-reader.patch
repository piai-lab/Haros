+		if (mutation.type === "remove") {
+			nextContent = applyEdits(
+				nextContent,
+				modify(nextContent, ["providers", mutation.providerId], undefined, {
+					formattingOptions: formattingOptions(nextContent),
+				}),
+			);
+		} else if (!currentConfig.getProvider(mutation.providerId)) {
+			nextContent = applyEdits(
+				nextContent,
+				modify(nextContent, ["providers", mutation.providerId], mutation.provider, {
