+ * Current v3 sessions are scanned as JSONL while retaining only the ancestry
+ * index and matching tool-result messages. Older formats are migrated in
+ * memory so their established Pi semantics remain intact without disk writes.
+ */
+export async function readToolResultFromSession(
+	filePath: string,
+	toolCallId: string,
+): Promise<ToolResultMessage | null> {
+	const resolvedFilePath = normalizePath(filePath);
+	if (!existsSync(resolvedFilePath)) return null;
+
+	const header = readSessionHeader(resolvedFilePath);
+	if (!header) return null;
+	const version = header.version ?? 1;
+	if (version > CURRENT_SESSION_VERSION) return null;
+
+	if (version < CURRENT_SESSION_VERSION) {
+		const fileEntries = loadEntriesFromFile(resolvedFilePath);
+		if (fileEntries.length === 0) return null;
+		migrateToCurrentVersion(fileEntries);
+		return findToolResultOnBranch(
