{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "HARNESSOS_HOME",
    "HARNESSOS_DESKTOP_WS_URL",
    "HARNESSOS_BROWSER_HOST_PIPE_PATH",
    "HARNESSOS_BROWSER_PERF",
    "HARNESSOS_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "HARNESSOS_GROK_ACP_DEBUG",
    "HARNESSOS_WEB_SOURCEMAP",
    "HARNESSOS_SERVER_SOURCEMAP",
    "HARNESSOS_DESKTOP_SOURCEMAP",
    "HARNESSOS_MODE",
    "HARNESSOS_PORT",
    "HARNESSOS_NO_BROWSER",
    "HARNESSOS_AUTH_TOKEN",
    "HARNESSOS_PUBLIC_URL",
    "HARNESSOS_ALLOW_INSECURE_REMOTE",
    "HARNESSOS_LOG_WS_EVENTS",
    "HARNESSOS_HOST",
    "HARNESSOS_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "outputLogs": "errors-only",
      "cache": true
    },
    "test": {
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^test:unit"],
      "cache": true,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:browser:stable": {
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:browser:geometry": {
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "@harnessos/server#test": {
      "dependsOn": ["@harnessos/oa-ask#build"],
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "@harnessos/server#typecheck": {
      "dependsOn": ["^typecheck", "@harnessos/oa-ask#build"],
      "outputs": [],
      "outputLogs": "errors-only",
      "cache": true
    },
    "@harnessos/server#test:unit": {
      "dependsOn": ["@harnessos/oa-ask#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/public/**",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/oa-web-access/**",
        "$TURBO_ROOT$/packages/shared/src/**"
      ],
      "cache": true,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "@harnessos/server#test:integration": {
      "dependsOn": ["@harnessos/oa-ask#build"],
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    }
  }
}
