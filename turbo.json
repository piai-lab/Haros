{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "OMNIMIND_HOME",
    "OMNIMIND_DESKTOP_WS_URL",
    "OMNIMIND_BROWSER_HOST_PIPE_PATH",
    "OMNIMIND_BROWSER_USE_PIPE_PATH",
    "OMNIMIND_BROWSER_PERF",
    "OMNIMIND_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "OMNIMIND_GROK_ACP_DEBUG",
    "OMNIMIND_WEB_SOURCEMAP",
    "OMNIMIND_SERVICE_SOURCEMAP",
    "OMNIMIND_DESKTOP_SOURCEMAP",
    "OMNIMIND_MODE",
    "OMNIMIND_PORT",
    "OMNIMIND_NO_BROWSER",
    "OMNIMIND_AUTH_TOKEN",
    "OMNIMIND_PUBLIC_URL",
    "OMNIMIND_ALLOW_INSECURE_REMOTE",
    "OMNIMIND_LOG_WS_EVENTS",
    "OMNIMIND_HOST",
    "OMNIMIND_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
