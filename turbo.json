{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "ELECTRON_RENDERER_PORT",
    "OMNIMIND_HOME",
    "OMNIMIND_DESKTOP_WS_URL",
    "OMNIMIND_BROWSER_HOST_PIPE_PATH",
    "OMNIMIND_BROWSER_PERF",
    "OMNIMIND_PROVIDER_RUNTIME_IDLE_STOP_MS",
    "OMNIMIND_GROK_ACP_DEBUG",
    "OMNIMIND_WEB_SOURCEMAP",
    "OMNIMIND_SERVER_SOURCEMAP",
    "OMNIMIND_DESKTOP_SOURCEMAP",
    "OMNIMIND_MODE",
    "OMNIMIND_PORT",
    "OMNIMIND_NO_BROWSER",
    "OMNIMIND_AUTH_TOKEN",
    "OMNIMIND_PUBLIC_URL",
    "OMNIMIND_ALLOW_INSECURE_REMOTE",
    "OMNIMIND_LOG_WS_EVENTS",
    "OMNIMIND_HOST",
    "OMNIMIND_AUTO_BOOTSTRAP_PROJECT_FROM_CWD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "outputLogs": "errors-only",
      "cache": true
    },
    "test": {
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^test:unit"],
      "cache": true,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:browser:stable": {
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "test:browser:geometry": {
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "@omnimind/server#test": {
      "dependsOn": ["@omnimind/om-ask#build"],
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "@omnimind/server#test:unit": {
      "dependsOn": ["@omnimind/om-ask#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/public/**",
        "$TURBO_ROOT$/packages/contracts/src/**",
        "$TURBO_ROOT$/packages/om-web-access/**",
        "$TURBO_ROOT$/packages/shared/src/**"
      ],
      "cache": true,
      "outputLogs": "errors-only",
      "outputs": []
    },
    "@omnimind/server#test:integration": {
      "dependsOn": ["@omnimind/om-ask#build"],
      "cache": false,
      "outputLogs": "errors-only",
      "outputs": []
    }
  }
}
